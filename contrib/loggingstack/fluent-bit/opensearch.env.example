# Environment of Fluent Bit on the nodes, e.g. /etc/fluent-bit/opensearch.env
# (readable by root only, it holds a password)

# the directory the flesnet programs write their log files to
FLESNET_LOG_DIR=/tmp/flesnet-log
# read positions and buffered chunks
FLUENT_BIT_STATE_DIR=/var/lib/fluent-bit

OPENSEARCH_HOST=10.0.101.1
OPENSEARCH_PASSWORD=
