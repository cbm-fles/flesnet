# Copy to .env and set the passwords. OpenSearch requires strong passwords:
# upper and lower case letters, digits and special characters.
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_FLUENTBIT_PASSWORD=
OPENSEARCH_GRAFANA_PASSWORD=

# address on the cluster network where the nodes reach OpenSearch
OPENSEARCH_CLUSTER_ADDRESS=10.0.101.1

# resource limits
OPENSEARCH_HEAP=4g
OPENSEARCH_MEM_LIMIT=8g
OPENSEARCH_CPUS=8
DASHBOARDS_MEM_LIMIT=2g
DASHBOARDS_CPUS=2

# retention of the log indices
OPENSEARCH_OPER_RETENTION=90d
OPENSEARCH_DEBUG_RETENTION=7d
