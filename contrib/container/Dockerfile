# flesnet image, built from the .deb packages generated by cpack. The build
# context needs the .git directory, as the version is derived from it.
#
#   docker build -f contrib/container/Dockerfile -t flesnet .

FROM debian:trixie-slim AS build
ARG PDA_VERSION=11.9.7
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates wget git cmake ninja-build g++ pkg-config dpkg-dev file \
      autoconf automake libtool \
      libboost-dev libboost-iostreams-dev libboost-program-options-dev \
      libboost-serialization-dev libboost-system-dev libboost-test-dev \
      libboost-thread-dev libboost-log-dev libnuma-dev libzmq3-dev cppzmq-dev \
      libfmt-dev libssl-dev libkmod-dev libpci-dev libtool-bin libucx-dev \
      libibverbs-dev librdmacm-dev \
 && wget -q -P /tmp https://github.com/cbm-fles/pda/releases/download/${PDA_VERSION}/libpda4_${PDA_VERSION}-1_amd64.deb \
 && apt-get install -y /tmp/libpda4_${PDA_VERSION}-1_amd64.deb
COPY . /src
RUN cmake -S /src -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DFLES_BUILD_TESTS=OFF \
 && ninja -C /build \
 && cd /build && cpack && mkdir /debs && cp *.deb /tmp/libpda4_*.deb /debs/

FROM debian:trixie-slim
COPY --from=build /debs /debs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      /debs/libpda4_*.deb /debs/flesnet-bin_*.deb ucx-utils iproute2 \
 && rm -rf /var/lib/apt/lists/* /debs
# Fails the build if the image lacks a runtime library
RUN tsbuilder --help
