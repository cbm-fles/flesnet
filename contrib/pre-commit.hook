#!/usr/bin/env python3

import subprocess
import sys

result = subprocess.run(
	["git", "clang-format", "--staged", "--diff"], capture_output=True, text=True
)

# git clang-format exits with 1 if it produced a diff, and with a higher value
# on actual errors (e.g. clang-format not found).
if result.returncode > 1:
	sys.stderr.write(result.stderr)
	print("Could not run git clang-format. Try running contrib/local-setup.")
	exit(result.returncode)

output = result.stdout.strip()
if output in ["", "no modified files to format", "clang-format did not modify any files"]:
	exit(0)

print(output)
print("Run git clang-format, then commit.")
exit(1)
